{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PRReviewerBot": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "PRReviewerBot": "Information"
      }
    }
  },
  "Review": {
    "MaxFilesToReview": 20,
    "MaxChangesToReview": 1000,
    "EnableDetailedLogging": false
  }
}
